# PHPStan at the highest level, as the family's harness runs it (docker compose run --rm omnischolar
# phpstan, in omnisense/omnischolar's docker/). phpstan-baseline.neon holds what was there when
# PHPStan came in (2026-11-10): it may only shrink.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
    ignoreErrors:
        # The source packages are optional: the bundle lists those it knows and registers the ones
        # installed (class_exists). The package's CI analyses it alone, the harness with all of them,
        # where PHPStan then finds the is_subclass_of() check always true.
        -
            identifier: class.notFound
            path: Bridge/Symfony/OmnischolarBundle.php
            reportUnmatched: false
        -
            identifier: function.alreadyNarrowedType
            path: Bridge/Symfony/OmnischolarBundle.php
            reportUnmatched: false
